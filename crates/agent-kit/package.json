{
  "name": "@nuwax-ai/agent-kit",
  "version": "0.3.2",
  "description": "Shared agent/ACP logic for nuwa-cli and nuwaclaw (engine resolution, agent install).",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "pretest": "pnpm build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@agentclientprotocol/sdk": "^0.26.0 || ^1.2.1",
    "@nuwax-ai/nuwax-codex-acp-ts": "^1.2.4"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "^1.2.1",
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
