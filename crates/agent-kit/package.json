{
  "name": "@nuwax-ai/agent-kit",
  "version": "0.4.0",
  "description": "Shared agent/ACP logic for nuwa-cli and nuwaclaw (engine resolution, agent install).",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "pretest": "pnpm build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@agentclientprotocol/sdk": "^0.26.0 || ^1.2.1",
    "@nuwax-ai/nuwax-codex-acp-ts": "^1.2.8"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@types/node": "^22.20.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nuwax-ai/nuwax-codex-acp-ts",
      "esbuild"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
