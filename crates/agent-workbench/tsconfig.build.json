{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist"
  },
  "include": [
    "src/index.ts",
    "src/vite-env.d.ts",
    "src/types.ts",
    "src/routes.ts",
    "src/sse.ts",
    "src/adapters/**/*.ts",
    "src/components/**/*.ts",
    "src/components/**/*.tsx"
  ],
  "exclude": ["tests", "src/**/*.test.ts", "**/*.spec.ts"]
}
