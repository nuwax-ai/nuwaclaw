{
  "name": "nuwaclaw",
  "version": "0.1.0",
  "description": "Headless multi-engine agent CLI — attaches to your already-installed & logged-in claude/codex CLIs over ACP, no separate login, no bundled runtime",
  "type": "module",
  "bin": {
    "nuwaclaw": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "pnpm run build",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "build:tsc": "tsc",
    "dev:build": "node scripts/build.mjs",
    "dev:cli": "node dist/cli.js",
    "dev:doctor": "node dist/cli.js doctor",
    "dev:chat": "node dist/cli.js chat",
    "dev:chat:codex": "node dist/cli.js chat --engine codex",
    "dev:sessions": "node dist/cli.js sessions",
    "dev:sessions:summary": "node dist/cli.js sessions summary",
    "dev:serve": "node dist/cli.js serve --port 60016",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.1.0",
    "@clack/prompts": "^1.7.0",
    "commander": "^15.0.0",
    "node-machine-id": "^1.1.12",
    "picocolors": "^1.1.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "better-sqlite3": "^12.11.1",
    "esbuild": "^0.27.3",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT"
}
