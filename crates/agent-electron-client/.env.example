# Feature Flags
# 开发时请复制此文件为 .env.development 并修改配置
# 生产环境请复制为 .env.production

# GUI Agent MCP 注入 (开发时设为 true)
INJECT_GUI_MCP=false

# 暗黑模式（默认关闭恒浅色；设 true 恢复暗黑与外观设置项）
# DARK_THEME=false

# 调试覆盖前端域名：webview 强制加载该前端源，后端域仍由 serverHost 决定
#（前后端一体；缺省 = 前后端同域名。详见 docs/design/loopback-gateway-design.md §6）
# NUWAX_WEBVIEW_ORIGIN=http://localhost:3000
