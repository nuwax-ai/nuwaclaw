# 开发环境配置
# 此文件用于本地开发，git 会追踪此文件

NODE_ENV=development

# Feature Flags
INJECT_GUI_MCP=true

# 日志不脱敏密钥（方便开发调试）
NUWAX_AGENT_LOG_FULL_SECRETS=true

# 打印完整 SSE 消息体（event + data），便于排查 computer/progress 流
NUWAX_AGENT_LOG_SSE_PAYLOAD=true

# 是否启用 agent-gui-server 模块（打包 + 启动 + 设置界面）
ENABLE_GUI_AGENT_SERVER=true

# nuwax 经 loopback 网关同源加载（NUWAX_LOOPBACK=1）。dev 形态自动判定：
# - nuwax dev server（localhost:3000，原开发的调试直连便利）在线 → webview 直连
# - 不在线且子模块 dist 就绪 → dist 形态（本地 nuwax，客户端随时可起）
# NUWAX_LOOPBACK_DIST=1 可强制 dist（跳过在线探测）；NUWAX_LOOPBACK_TARGET 覆盖后端。
NUWAX_LOOPBACK=1
# NUWAX_LOOPBACK_DIST=1
# NUWAX_LOOPBACK_TARGET=https://agent.nuwax.com

# 调试覆盖前端域名：webview 强制加载该前端源（如本地 nuwax dev server）。
# 后端域不受影响（仍由 step1_config.serverHost 决定——前后端一体语义，
# 见 docs/design/loopback-gateway-design.md §6）；缺省 = 前后端同域名。
# vite dev 形态本就内置加载 localhost:3000，此项主要用于打包形态/自定义前端源调试。
# NUWAX_WEBVIEW_ORIGIN=http://localhost:3000
