# 开发环境配置
# 此文件用于本地开发，git 会追踪此文件

NODE_ENV=development

# Feature Flags
INJECT_GUI_MCP=true

# 日志不脱敏密钥（方便开发调试）
NUWAX_AGENT_LOG_FULL_SECRETS=true

# 打印完整 SSE 消息体（event + data），便于排查 computer/progress 流
NUWAX_AGENT_LOG_SSE_PAYLOAD=true

# 是否启用 agent-gui-server 模块（打包 + 启动 + 设置界面）
ENABLE_GUI_AGENT_SERVER=true

# nuwax 经 loopback 网关同源加载（http://127.0.0.1:46800/ 反代 dev 目标）——
# dev 目标缺省 localhost:3000（NUWAX_DEV_HOST 同源语义）；要指生产时取消下行注释
NUWAX_LOOPBACK=1
# NUWAX_LOOPBACK_TARGET=https://agent.nuwax.com
