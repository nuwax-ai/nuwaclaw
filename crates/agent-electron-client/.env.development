# 开发环境配置
# 此文件用于本地开发，git 会追踪此文件

NODE_ENV=development

# Feature Flags
INJECT_GUI_MCP=true

# 日志不脱敏密钥（方便开发调试）
NUWAX_AGENT_LOG_FULL_SECRETS=true

# 是否启用 agent-gui-server 模块（打包 + 启动 + 设置界面）
ENABLE_GUI_AGENT_SERVER=true

# Agent Mode：默认走真实远端 API（需先登录并完成 /reg）
# 联调时可填写后端返回的 appAgentId（也可在 设置 → Agent Mode 中配置）
# VITE_NUWAX_APP_AGENT_ID=286
# 仅本地 UI 联调 mock 时开启：
# VITE_NUWAX_ENABLE_WORKBENCH_MOCK=true
