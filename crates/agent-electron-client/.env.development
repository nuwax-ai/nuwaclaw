# 开发环境配置
# 此文件用于本地开发，git 会追踪此文件

NODE_ENV=development

# Feature Flags
INJECT_GUI_MCP=true

# 日志不脱敏密钥（方便开发调试）
NUWAX_AGENT_LOG_FULL_SECRETS=true

# 打印完整 SSE 消息体（event + data），便于排查 computer/progress 流
NUWAX_AGENT_LOG_SSE_PAYLOAD=true

# 是否启用 agent-gui-server 模块（打包 + 启动 + 设置界面）
ENABLE_GUI_AGENT_SERVER=true

# nuwax 经 loopback 网关同源加载。两种形态：
# - dist 形态（DSH Desktop 同款）：NUWAX_LOOPBACK_DIST=1 —— 网关托管仓库根
#   nuwax/ 子模块 dist（feat/pc-client-bridge，dist 随分支入库免构建），
#   /api 等后端前缀反代 serverHost；后端绝对 URL 自动归一回网关（免 CORS）。
# - 透明反代：NUWAX_LOOPBACK=1 —— 全站反代目标；目标为 localhost:3000
#   （nuwax dev server）时自动跳过网关直连，保留原始 dev 体验。
NUWAX_LOOPBACK=1
# NUWAX_LOOPBACK_DIST=1
# NUWAX_LOOPBACK_TARGET=https://agent.nuwax.com
