{
  "name": "nuwaclaw-shell",
  "version": "1.0.0",
  "private": true,
  "description": "NuwaClaw 社区版 Electron 客户端 —— 产品发布壳（功能模块在基座仓 nuwax-ai/nuwa-electron-shell main 分支）",
  "packageManager": "pnpm@9.15.5",
  "scripts": {
    "in-base": "node scripts/in-base.js",
    "base:install": "node scripts/in-base.js -- pnpm install --filter @nuwax-ai/nuwaclaw...",
    "base:dev": "node scripts/in-base.js -- make electron-dev",
    "base:test": "node scripts/in-base.js -- npm run test:electron",
    "base:bundle": "node scripts/in-base.js -- make electron-bundle-unsigned"
  }
}
